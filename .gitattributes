# The git-annex hooks are run by git's shell: a CRLF checkout on Windows would break them.
build/git-hooks/* text eol=lf
# CRLF would break the install script under bash and the text checks in its tests.
scripts/macos/*.sh text eol=lf
scripts/linux/*.sh text eol=lf
# Runs on the Linux server: a CRLF copy from a Windows checkout would not start.
server/* text eol=lf
